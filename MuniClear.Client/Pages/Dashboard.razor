@page "/dashboard"
@inject NavigationManager Nav

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Good Day, Resident</h2>
        <button class="btn btn-outline-danger btn-sm" @onclick='() => Nav.NavigateTo("/")'>Sign Out</button>
    </div>

    <!-- Capitec-Style Account Card -->
    <div class="card shadow-sm border-0 mb-4" style="background: linear-gradient(135deg, #007bff 0%, #0056b3 100%); border-radius: 20px; color: white;">
        <div class="card-body p-4">
            <p class="mb-1 opacity-75">Main Account</p>
            <h1 class="fw-bold">R 1,240.50</h1>
            <p class="small mt-3">Account Number: 1029384756</p>
        </div>
    </div>

    <!-- Action Grid -->
    <div class="row g-3">
        <div class="col-6">
            <button class="btn btn-light w-100 py-4 shadow-sm" @onclick='() => Nav.NavigateTo("/electricity")' style="border-radius: 15px;">
                <i class="bi bi-lightning-charge text-warning d-block fs-2 mb-2"></i>
                Electricity
            </button>
        </div>
        <div class="col-6">
            <button class="btn btn-light w-100 py-4 shadow-sm" style="border-radius: 15px;">
                <i class="bi bi-water text-primary d-block fs-2 mb-2"></i>
                Water
            </button>
        </div>
    </div>
</div>
