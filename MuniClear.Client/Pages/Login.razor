@page "/login"
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav

@* 1. THE ENGINE (Icons & Animations) *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com" />

<style>
    .login-body {
        background: radial-gradient(at 0% 0%, hsla(210,100%,98%,1) 0, transparent 50%), radial-gradient(at 100% 0%, hsla(225,100%,96%,1) 0, transparent 50%);
        background-color: #fbfbfd;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: -apple-system, "SF Pro Display", sans-serif;
    }

    .glass-card {
        max-width: 420px;
        width: 90%;
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(20px);
        border-radius: 35px;
        padding: 45px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.08);
        border: 1px solid rgba(255,255,255,0.5);
    }

    .input-group {
        margin-bottom: 15px;
        text-align: left;
    }

    .apple-input {
        width: 100%;
        padding: 16px;
        border-radius: 14px;
        border: 1.5px solid #d2d2d7;
        background: #fff;
        font-size: 1rem;
        outline: none;
        transition: 0.3s;
    }

        .apple-input:focus {
            border-color: #0071e3;
            box-shadow: 0 0 0 4px rgba(0,113,227,0.1);
        }

    .btn-main {
        width: 100%;
        padding: 18px;
        border-radius: 16px;
        border: none;
        background: #0071e3;
        color: white;
        font-weight: 600;
        font-size: 1.1rem;
        cursor: pointer;
        transition: 0.3s;
        margin-top: 10px;
    }

        .btn-main:hover {
            background: #0077ed;
            transform: scale(1.02);
        }

    .link-text {
        color: #0071e3;
        text-decoration: none;
        font-weight: 500;
        font-size: 0.85rem;
        cursor: pointer;
    }
</style>

<div class="login-body">
    <div class="glass-card animate__animated animate__zoomIn">

        <!-- Brand Logo -->
        <div style="text-align: center; margin-bottom: 35px;">
            <div style="background: #0071e3; width: 60px; height: 60px; border-radius: 18px; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 15px; box-shadow: 0 10px 20px rgba(0,112,201,0.2);">
                <i class="bi bi-shield-lock-fill text-white" style="font-size: 2rem;"></i>
            </div>
            <h2 style="font-weight: 800; color: #1d1d1f; letter-spacing: -1px; margin: 0;">MuniClear</h2>
            <p style="color: #86868b; font-size: 0.9rem; margin-top: 5px;">Secure Utilities Access</p>
        </div>

        @if (ViewState == "Login")
        {
            <div class="animate__animated animate__fadeIn">
                <div class="input-group">
                    <input type="email" @bind="Email" class="apple-input" placeholder="Email Address" />
                </div>
                <div class="input-group">
                    <input type="password" @bind="IdNumber" class="apple-input" placeholder="SA ID Number" />
                </div>

                <button class="btn-main" @onclick="HandleLogin" disabled="@IsBusy">
                    @if (IsBusy)
                    {
                        <span>Verifying...</span>
                    }
                    else
                    {
                        <span>Sign In</span>
                    }
                </button>

                <div style="margin-top: 25px; display: flex; justify-content: space-between;">
                    <span class="link-text" @onclick='() => ViewState = "Register"'>Create Account</span>
                    <span class="link-text" @onclick='() => ViewState = "Forgot"'>Forgot Password?</span>
                </div>
            </div>
        }
        else if (ViewState == "Register")
        {
            <div class="animate__animated animate__fadeIn">
                <h4 style="font-weight: 700; margin-bottom: 20px;">New Resident</h4>
                <input type="text" class="apple-input mb-3" placeholder="Full Name" />
                <input type="email" class="apple-input mb-3" placeholder="Email Address" />
                <input type="text" class="apple-input mb-3" placeholder="SA ID Number" />
                <button class="btn-main" @onclick='() => ViewState = "Login"'>Create Account</button>
                <p class="mt-3"><span class="link-text" @onclick='() => ViewState = "Login"'>Already have an account? Sign In</span></p>
            </div>
        }
        else
        {
            <div class="animate__animated animate__fadeIn">
                <h4 style="font-weight: 700; margin-bottom: 10px;">Reset Password</h4>
                <p style="color: #86868b; font-size: 0.85rem; margin-bottom: 20px;">Enter your email to receive a recovery link.</p>
                <input type="email" class="apple-input mb-3" placeholder="Email Address" />
                <button class="btn-main" @onclick='() => ViewState = "Login"'>Send Reset Link</button>
                <p class="mt-3"><span class="link-text" @onclick='() => ViewState = "Login"'>Back to Sign In</span></p>
            </div>
        }

        @if (!string.IsNullOrEmpty(Error))
        {
            <p class="text-danger small mt-3 animate__animated animate__shakeX">⚠️ @Error</p>
        }
    </div>
</div>

@code {
    private string ViewState = "Login"; // Login, Register, Forgot
    private string Email = "";
    private string IdNumber = "";
    private string? Error;
    private bool IsBusy = false;

    private async Task HandleLogin()
    {
        IsBusy = true; Error = null;
        try
        {
            var response = await Http.PostAsJsonAsync("api/Payments/login", new { Email, IdNumber });
            if (response.IsSuccessStatusCode)
            {
                Nav.NavigateTo("/");
            }
            else
            {
                Error = "Invalid credentials. Access denied.";
            }
        }
        catch
        {
            Error = "Connection error. Is the API running?";
        }
        finally { IsBusy = false; }
    }
}
